{
    "name": "server",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --runInBand --forceExit --silent",
        "test:coverage": "jest --runInBand --forceExit --silent --coverage"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "collectCoverageFrom": [
            "controllers/**/*.js",
            "middleware/**/*.js",
            "utils/**/*.js"
        ]
    },
    "dependencies": {
        "adm-zip": "^0.5.10",
        "axios": "^1.13.2",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-parser": "^3.2.0",
        "dotenv": "^16.0.3",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "form-data": "^4.0.0",
        "helmet": "^8.2.0",
        "joi": "^18.2.1",
        "jsonwebtoken": "^9.0.0",
        "libreoffice-convert": "^1.7.0",
        "mammoth": "^1.6.0",
        "multer": "^2.0.2",
        "mysql2": "^3.0.1",
        "node-fetch": "^2.7.0",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "nodemon": "^2.0.20",
        "supertest": "^7.2.2"
    }
}
